# Default: no cloud calls. Load explicitly into the server process if enabled.
PETSENSE_ENABLE_CLOUD=false
PETSENSE_VLM_MODEL=
OPENAI_API_KEY=
# Local development authentication; never embed a shared token in a released app.
PETSENSE_API_TOKEN=
# Local near-real-time audio; no cloud API is called.
PETSENSE_ENABLE_AUDIO=false
PETSENSE_AUDIO_MODEL=
PETSENSE_AUDIO_MODEL_APPROVED=false
