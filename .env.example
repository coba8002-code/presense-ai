# Default: no cloud calls. Load explicitly into the server process if enabled.
PETSENSE_ENABLE_CLOUD=false
PETSENSE_VLM_MODEL=
OPENAI_API_KEY=
# Local development authentication; never embed a shared token in a released app.
PETSENSE_API_TOKEN=
# Local near-real-time audio; no cloud API is called.
PETSENSE_ENABLE_AUDIO=false
PETSENSE_AUDIO_MODEL=
PETSENSE_AUDIO_MODEL_APPROVED=false
# URL knowledge worker: explicit opt-in; no credentials are bundled.
PETSENSE_ENABLE_KNOWLEDGE=false
YOUTUBE_API_KEY=
GEMINI_API_KEY=
PETSENSE_KNOWLEDGE_CONFIG=
PETSENSE_KNOWLEDGE_DB=data/knowledge.sqlite3
# Optional NotebookLM Enterprise; short-lived token or externally refreshed file.
GOOGLE_ACCESS_TOKEN=
GOOGLE_ACCESS_TOKEN_FILE=

# Optional local AST whole-WAV event scores; not production behavior classification
PETSENSE_ENABLE_AST=false

# Local-PC prototype notes; omit/empty to disable. Keep DB private and outside Git.
# PETSENSE_ACCOUNT_DB=data/private/notes.sqlite3
