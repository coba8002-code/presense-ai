# Copy to /etc/petsense/beta.env (0600), then replace every CHANGE_ME.
PETSENSE_ACCOUNT_DB=/var/lib/petsense/private/accounts.sqlite3
PETSENSE_ENABLE_WEB_AUTH=true
PETSENSE_REQUIRE_ACCOUNT=true
PETSENSE_PUBLIC_ORIGIN=https://CHANGE_ME
PETSENSE_OPERATOR_NAME=CHANGE_ME
PETSENSE_PRIVACY_CONTACT=CHANGE_ME
PETSENSE_TERMS_VERSION=CHANGE_ME
PETSENSE_PRIVACY_VERSION=CHANGE_ME
PETSENSE_SIGNUP_MODE=closed
# For explicitly enrolled testers only; not email ownership verification.
PETSENSE_SIGNUP_ALLOWLIST=
PETSENSE_ENABLE_AST_JOBS=false
PETSENSE_ENABLE_AST=false
PETSENSE_ENABLE_CLOUD=false
PETSENSE_ENABLE_KNOWLEDGE=false
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
